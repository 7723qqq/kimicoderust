  "rules": {
    "layerOrder": [
      "app",
      "sdk",
      "engine",
      "shared"
    ],
    "forbid": [
      {
        "from": "engine",
        "to": "app",
        "reason": "engine 不依赖 app"
      },
      {
        "from": "engine",
        "to": "sdk",
        "reason": "engine 不依赖 sdk"
      },
      {
        "from": "shared",
        "to": "app",
        "reason": "shared 不依赖 app"
      },
      {
        "from": "shared",
        "to": "sdk",
        "reason": "shared 不依赖 sdk"
      },
      {
        "from": "shared",
        "to": "engine",
        "reason": "shared 不依赖 engine"
      }
    ],
    "acyclic": true
  },
  "exemptions": [
    {
      "from": "i18n-runtime",
      "to": "kimi-agent",
      "reason": "i18n-runtime 只在 try/catch 内 require napi 原生模块（packages/i18n-runtime/src/i18n.ts:69）拿更快的翻译路径，并有纯 JS 兜底（translatePure 走 flatMessages 扁平表，可用 KIMI_I18N_FORCE_JS 强制）；浏览器与单文件打包下原生模块不存在，因此这是运行期可选的软依赖，不应记为构建期硬依赖。"
    }
  ]
