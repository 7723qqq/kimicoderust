{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": ".tmp-api-extractor/dts",
    "rootDir": ".."
  },
  "include": [
    "src/**/*.ts",
    "../i18n-catalog/src/**/*.ts",
    "../i18n-runtime/src/**/*.ts",
    "../i18n-shared/src/**/*.ts",
    "../kaos/src/**/*.ts",
    "../kimi-agent/session-handle.ts",
    "../kimi-agent/wire-schema.ts",
    "../kosong/src/**/*.ts",
    "../oauth/src/**/*.ts",
    "../protocol/src/**/*.ts",
    "../tree-sitter-bash/src/**/*.ts"
  ],
  "exclude": ["dist", ".tmp-api-extractor", "examples", "test", "../*/dist", "../*/test"]
}
